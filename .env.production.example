# Copy to .env.production, then replace every example/placeholder value.
SECRET_KEY=generate-a-new-private-django-secret-key
DEBUG=False
DOMAIN=cinemora.example.com
ALLOWED_HOSTS=cinemora.example.com
CSRF_TRUSTED_ORIGINS=https://cinemora.example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

POSTGRES_DB=cinemora
POSTGRES_USER=cinemora
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
MEDIA_ROOT=/app/media

# Leave blank until SMTP is configured; the app currently sends no email.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
